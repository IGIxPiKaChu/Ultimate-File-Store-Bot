# Mariya / CodeXBotz-compatible environment
# Required
TG_BOT_TOKEN=
APP_ID=
API_HASH=
OWNER_ID=
CHANNEL_ID=

# MongoDB (DATABASE_URL is preferred; legacy DB_URL is also accepted)
DATABASE_URL=
DATABASE_NAME=filesharexbot

# Optional: leave FORCE_SUB_CHANNEL=0 to disable force-sub
FORCE_SUB_CHANNEL=0
JOIN_REQUEST_ENABLED=False

# Optional bot presentation
START_MESSAGE=Hello {first}! I’m Mariya, your personal file-sharing bot.
START_PIC=
FORCE_SUB_MESSAGE=
CUSTOM_CAPTION=
DISABLE_CHANNEL_BUTTON=False
PROTECT_CONTENT=False

# Optional automatic deletion (seconds; 0 disables)
AUTO_DELETE_TIME=0
AUTO_DELETE_MSG=
AUTO_DEL_SUCCESS_MSG=

# Optional service settings
TG_BOT_WORKERS=4
PORT=8080
