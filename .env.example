# Mariya — environment configuration
# Required Telegram credentials
TG_BOT_TOKEN=
APP_ID=
API_HASH=
CHANNEL_ID=
OWNER_ID=

# MongoDB
DB_URL=
DB_NAME=FileStoreBot

# Owner and administrators
OWNER_TAG=
ADMINS=

# Access control: fsub, referral, dual, or off
ACCESS_MODE=fsub
FORCE_SUB_CHANNEL=
FORCE_SUB_CHANNEL2=
FORCE_SUB_CHANNEL3=
FORCE_SUB_CHANNEL4=
FORCE_MSG=
FORCE_PIC=

# Referrals
REFERRAL_COUNT=3
REFERRAL_EXPIRE=0
REFERRAL_MSG=
REFERRAL_SHARE_TEXT=
REFERRAL_PIC=

# Start screen
START_MESSAGE=
START_PIC=

# File delivery
CUSTOM_CAPTION=💗 Shared with you via Mariya
PROTECT_CONTENT=FALSE
TIME=0
DISABLE_CHANNEL_BUTTON=TRUE

# Optional shortener / verification
USE_SHORTLINK=FALSE
SHORTLINK_API_URL=
SHORTLINK_API_KEY=
U_S_E_P=TRUE
VERIFY_EXPIRE=43200
TUT_VID=

# Optional premium / payments (disabled by default)
USE_PAYMENT=FALSE
UPI_ID=
UPI_IMAGE_URL=
SCREENSHOT_URL=
PRICE1=₹200
PRICE2=₹500
PRICE3=₹800
PRICE4=₹1500
PRICE5=₹2850

# Other settings
USER_REPLY_TEXT=💗 Welcome to Mariya. Only admins can upload files directly; everyone else can open a shared file link.
BOT_STATS_TEXT=<b>MARIYA UPTIME</b>\n{uptime}
PORT=8080
TG_BOT_WORKERS=50
